TELEGRAM_BOT_TOKEN=000000000:telegram-token

JIRA_BASE_URL=https://jira.moscow.alfaintra.net
JIRA_AUTH_MODE=bearer
JIRA_USERNAME=ivanov
JIRA_API_TOKEN=change-me
JIRA_PROJECT_KEY=DFA
JIRA_ISSUE_TYPE=Task

# Legacy Jira installations often use custom fields for Epic Link, Epic Name, and Sprint.
JIRA_EPIC_LINK_FIELD=customfield_10376
JIRA_EPIC_NAME_FIELD=customfield_10377
JIRA_SPRINT_FIELD=customfield_10375
JIRA_TASK_TYPE_FIELD=customfield_33794
JIRA_DEFAULT_TASK_TYPE=Задача развития
JIRA_ESTIMATE_FIELD=customfield_10372

# Required for sprint lookup through Jira Agile API.
# If /rest/agile/1.0 is missing, the bot falls back to old GreenHopper sprintquery API.
JIRA_BOARD_ID=28235

# Defaults used when a message does not mention an epic or sprint.
JIRA_DEFAULT_EPIC_KEY=DFA-33230
JIRA_DEFAULT_EPIC_NAME="[Q2-Q4_26ЦФА] Мелкие доработки 2026"
JIRA_DEFAULT_SPRINT_QUERY="[DFA:STORM]"
JIRA_DEFAULT_ASSIGNEE_KEY=U_M28HF
JIRA_DEFAULT_ASSIGNEE_NAME=Трубенёв Тимофей Александрович
JIRA_DEFAULT_ASSIGNEE_EMAIL=TTrubenev@alfabank.ru

# Set false only if corporate Jira has an internal certificate that is not trusted locally.
JIRA_VERIFY_TLS=false

# Optional: local or corporate speech-to-text command.
# The bot passes a downloaded Telegram voice file path as the first argument and expects text in stdout.
# Example: VOICE_TRANSCRIBER_COMMAND=/usr/local/bin/company-stt
VOICE_TRANSCRIBER_COMMAND=
