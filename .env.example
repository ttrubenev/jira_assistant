TELEGRAM_BOT_TOKEN=

JIRA_BASE_URL=https://jira.example.local
JIRA_AUTH_MODE=basic
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Legacy Jira installations often use custom fields for Epic Link, Epic Name, and Sprint.
JIRA_EPIC_LINK_FIELD=customfield_TODO
JIRA_EPIC_NAME_FIELD=customfield_TODO
JIRA_SPRINT_FIELD=customfield_TODO
JIRA_TASK_TYPE_FIELD=customfield_TODO
JIRA_DEFAULT_TASK_TYPE=
JIRA_ESTIMATE_FIELD=customfield_TODO

# Required for sprint lookup through Jira Agile API.
# If /rest/agile/1.0 is missing, the bot falls back to old GreenHopper sprintquery API.
JIRA_BOARD_ID=

# Defaults used when a message does not mention an epic or sprint.
JIRA_DEFAULT_EPIC_KEY=
JIRA_DEFAULT_EPIC_NAME=
JIRA_DEFAULT_SPRINT_QUERY=
JIRA_DEFAULT_ASSIGNEE_KEY=
JIRA_DEFAULT_ASSIGNEE_NAME=
JIRA_DEFAULT_ASSIGNEE_EMAIL=

# Set false only if corporate Jira has an internal certificate that is not trusted locally.
JIRA_VERIFY_TLS=false

# Optional AI agent. When disabled, the bot uses deterministic parsing only.
AI_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_INTENT_MODEL=gpt-5.5
