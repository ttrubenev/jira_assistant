<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.company.jira-assistant-bot</string>

  <key>WorkingDirectory</key>
  <string>/Users/yourname/Documents/jira_assistant</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/yourname/Documents/jira_assistant/src</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yourname/Documents/jira_assistant/.venv/bin/python</string>
    <string>-m</string>
    <string>jira_assistant_bot</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/yourname/Documents/jira_assistant/logs/bot.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/yourname/Documents/jira_assistant/logs/bot.err.log</string>
</dict>
</plist>
